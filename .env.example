# Root environment file for docker-compose.yml
# Copy this file to `.env` and fill in real values before running docker-compose up.
#
# Generate strong secrets with one of:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Medusa backend ---
JWT_SECRET=
COOKIE_SECRET=

# --- Payload CMS ---
PAYLOAD_SECRET=

# --- Shared: Medusa -> Payload sync ---
# API key of the Payload admin user (Users collection, enableAPIKey).
# Rotate immediately: the old value was committed to git history.
PAYLOAD_API_KEY=
PAYLOAD_USER_COLLECTION=users

# --- Storefront (NEXT_PUBLIC_* are baked into the client bundle) ---
# Rotate immediately: the old value was committed to git history.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# --- Postgres (docker-compose database service, local only) ---
POSTGRES_PASSWORD=postgres
